DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_LANGUAGE_CODE=ar
DJANGO_TIME_ZONE=Asia/Aden
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=school_saas_db
POSTGRES_USER=school_user
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
TRUST_X_FORWARDED_FOR=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
THROTTLE_ANON=1000/hour
THROTTLE_USER=5000/hour
THROTTLE_LOGIN=100/hour
THROTTLE_REFRESH=200/hour
THROTTLE_LOGOUT=200/hour
THROTTLE_REPORTS=1000/hour
THROTTLE_BULK_ATTENDANCE=500/hour
THROTTLE_DOCS=300/hour

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.invalid
THROTTLE_BULK_RESULTS=500/hour

THROTTLE_BULK_PUBLISH=200/hour

# Homework and submission attachments
MAX_HOMEWORK_ATTACHMENT_SIZE_MB=10
MAX_SUBMISSION_ATTACHMENT_SIZE_MB=10
MAX_ATTACHMENTS_PER_HOMEWORK=10
MAX_ATTACHMENTS_PER_SUBMISSION=10
ALLOWED_ATTACHMENT_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,jpg,jpeg,png
ALLOWED_ATTACHMENT_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,image/jpeg,image/png
THROTTLE_HOMEWORK_WRITE=500/hour
THROTTLE_HOMEWORK_SUBMIT=500/hour
THROTTLE_HOMEWORK_BULK_GRADE=200/hour
THROTTLE_ATTACHMENT_UPLOAD=200/hour
# Sprint 4B communication throttles and attachments
THROTTLE_NOTIFICATION_LIST=1000/hour
THROTTLE_NOTIFICATION_READ=1000/hour
THROTTLE_NOTIFICATION_READ_ALL=300/hour
THROTTLE_NOTIFICATION_BROADCAST=100/hour
THROTTLE_CONVERSATION_LIST=1000/hour
THROTTLE_MESSAGE_SEND=500/hour
THROTTLE_MESSAGE_ATTACHMENT_UPLOAD=200/hour
THROTTLE_SCHOOL_SUPPORT_CREATE=100/hour
THROTTLE_SCHOOL_SUPPORT_REPLY=500/hour
THROTTLE_HOMEWORK_DASHBOARD=1000/hour
MAX_MESSAGE_LENGTH=4000
MAX_MESSAGE_ATTACHMENT_SIZE_MB=10
MAX_ATTACHMENTS_PER_MESSAGE=5
ALLOWED_MESSAGE_ATTACHMENT_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,jpg,jpeg,png
ALLOWED_MESSAGE_ATTACHMENT_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,image/jpeg,image/png
