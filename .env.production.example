# Copy to .env.production on the server and fill every value. Never commit the real file.
DJANGO_ENV=production
DJANGO_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=school.example.com
CORS_ALLOWED_ORIGINS=https://school.example.com
CSRF_TRUSTED_ORIGINS=https://school.example.com
DJANGO_TIME_ZONE=Asia/Aden
# Raise to 31536000 only after HTTPS works for every host name.
SECURE_HSTS_SECONDS=0

POSTGRES_DB=school_saas
POSTGRES_USER=school_saas
POSTGRES_PASSWORD=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@school.example.com
PASSWORD_RESET_URL=https://school.example.com/reset-password

# Default currency for school fees and platform plans (ISO 4217).
DEFAULT_CURRENCY=YER

WEB_PORT=8080

# Scheduler containers (hours are UTC). Billing jobs run daily, backups nightly.
BILLING_JOB_HOUR_UTC=4
BACKUP_HOUR_UTC=23
BACKUP_KEEP_DAYS=14
